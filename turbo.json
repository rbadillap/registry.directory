{
  "$schema": "https://v2-8-7.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["SUBMISSION_SECRET", "CRON_SECRET", "DASHBOARD_ENABLED", "APP_DATABASE_URL", "APP_BASE_URL"],
  "globalDependencies": [".github/workflows/ci.yml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV", "BLOB_STORE_ID", "SUBMISSION_SECRET", "CRON_SECRET"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
