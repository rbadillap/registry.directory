{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://registry.directory/schemas/directory.json",
  "title": "Registry Directory",
  "description": "Collection of shadcn/ui component registries",
  "type": "object",
  "required": ["registries"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "registries": {
      "type": "array",
      "description": "List of registry entries",
      "items": {
        "type": "object",
        "required": ["name", "description", "url"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the registry",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "description": "Brief description of what this registry provides",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Homepage URL of the registry",
            "pattern": "^https://"
          },
          "github_url": {
            "type": "string",
            "format": "uri",
            "description": "GitHub repository URL",
            "pattern": "^https://github\\.com/"
          },
          "github_profile": {
            "type": "string",
            "format": "uri",
            "description": "GitHub profile image URL",
            "pattern": "^https://"
          },
          "registry_url": {
            "type": "string",
            "format": "uri",
            "description": "Direct URL to registry.json file (if different from url/r/registry.json)",
            "pattern": "^https://"
          },
          "namespace": {
            "type": "string",
            "description": "Official shadcn registry namespace handle (e.g. @aceternity), as listed in the shadcn registry index",
            "pattern": "^@[a-z0-9][a-z0-9-]*$"
          },
          "featured": {
            "type": "array",
            "description": "Item names curated for the landing page. Absent or empty hides the Featured section; at most 6 are shown",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true
          },
          "pro": {
            "type": "object",
            "description": "Paid offering checks. Absent hides the PRO card; when present all five must be declared so absences (false) are comparable data",
            "required": [
              "pro_blocks",
              "templates",
              "figma_kit",
              "mcp_agent",
              "team_license"
            ],
            "properties": {
              "pro_blocks": {
                "type": "boolean",
                "description": "Sells pro blocks / components"
              },
              "templates": {
                "type": "boolean",
                "description": "Sells complete templates"
              },
              "figma_kit": {
                "type": "boolean",
                "description": "Offers a Figma kit"
              },
              "mcp_agent": {
                "type": "boolean",
                "description": "Offers MCP server / agent skills / AI tooling"
              },
              "team_license": {
                "type": "boolean",
                "description": "Offers a team license tier"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
