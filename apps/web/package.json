{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "index": "varlock run -- node scripts/index.mjs",
    "views:check": "node scripts/views-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:first-admin": "varlock run -- node db/first-admin.mjs",
    "test": "node --test scripts/**/*.test.mjs lib/**/*.test.ts db/**/*.test.ts",
    "prebuild": "node scripts/views-check.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "rm -rf .next/types && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.33.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "@workspace/organizations": "workspace:*",
    "@workspace/ui": "workspace:*",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.475.0",
    "next": "^15.5.9",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-resizable-panels": "^2.1.7",
    "shadcn": "^3.7.0",
    "shiki": "^1.0.0",
    "varlock": "^1.20.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "^20.19.26",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@varlock/1password-plugin": "^2.0.4",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3"
  }
}
