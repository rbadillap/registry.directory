# The environment apps/web reads, in @env-spec:
# https://varlock.dev/env-spec/overview/
# Secrets are references to 1Password, resolved by Varlock when a command runs.
#
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# ---

# --- indexer (pnpm index, from apps/web) -------------------------------------
# Nothing the site renders comes from these: pages read apps/web/data, which
# the indexer writes.

# Stars and last-push dates for data/github.json. A fine-grained token with
# read-only access to public repositories.
# @sensitive
GITHUB_TOKEN=op(op://personal-dev/registry-directory-github/credential)

# --- indexer AND runtime -----------------------------------------------------
# Vercel Blob, a private store: locally the indexer archives a snapshot per run
# and reads the history, and on Vercel /api/submit and /api/feedback store what
# they receive. The SDK authenticates with Vercel OIDC paired with the store's
# id; there is no long-lived Blob token. On Vercel both come with the store's
# connection to the project.

# The store's id: an identifier, not a secret.
BLOB_STORE_ID=store_9pGzvSZxe4pAvI5W

# A development OIDC token for the project, valid 12 hours, issued on each run.
# The Vercel CLI runs through 1Password's shell plugin (`op plugin run`), which
# passes the CLI its token: no Vercel login is saved on the machine.
# @sensitive
VERCEL_OIDC_TOKEN=exec(`op plugin run -- vercel project token registry.directory --json --scope rbadillap-labs | jq -r .token`)

# --- runtime -----------------------------------------------------------------
# Affiliates (set to false to disable all affiliate links)
# @type=boolean
NEXT_PUBLIC_AFFILIATES_ENABLED=true

# Feedback widget (internal dogfooding)
NEXT_PUBLIC_FEEDBACK_ENABLED=

# Registry submissions (/api/submit): HMAC key for submission update tokens.
# Without it, submissions still work but pending entries cannot be updated.
# Set on Vercel.
# @sensitive
SUBMISSION_SECRET=
